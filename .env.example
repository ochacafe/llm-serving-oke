# このファイルを .env にコピーして値を入れる（.env は .gitignore 済み）。
# 環境変数で直接 export しても同じ（環境変数が優先）。

# OCI CLI のプロファイル（~/.oci/config）。リージョンもこのプロファイルから決まる。
OCI_CLI_PROFILE=DEFAULT

# OKE / VCN を作成するコンパートメント OCID
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxxxxx

# Kubernetes API の許可 CIDR（カンマ区切り）。未設定なら 10-infra-up.sh が手元のグローバル IP/32 を自動検出する。
# ADMIN_CIDRS=203.0.113.10/32

# Deploy to OCI ボタンで作ったクラスタを使う場合は OCID を指定（10-infra-up.sh は kubeconfig 生成のみ行う）
# OKE_CLUSTER_ID=ocid1.cluster.oc1.xxxxxxxx
