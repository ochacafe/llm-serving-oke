{
  "uid": "pd",
  "title": "Step 3: Prefill / Decode 分離",
  "description": "sim-pd の Prefill Pod と Decode Pod の動き",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-10m",
    "to": "now"
  },
