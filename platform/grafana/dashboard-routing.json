{
  "uid": "routing",
  "title": "Step 2: 普通の LB vs llm-d スケジューラ",
  "description": "同じ負荷を sim-baseline と sim-llmd にミラーリングして比較する",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "browser",
  "tags": [
    "llm-demo"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "## 普通の LB（P2C）\n`llmisvc=sim-baseline`"
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "## llm-d スケジューラ\n`llmisvc=sim-llmd`"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Prefix cache ヒット率（普通の LB（P2C））",
      "description": "キャッシュ済みトークン数 / 問い合わせトークン数（直近 1 分）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(vllm:prefix_cache_hits_total{llmisvc=\"sim-baseline\"}[1m])) / clamp_min(sum(rate(vllm:prefix_cache_queries_total{llmisvc=\"sim-baseline\"}[1m])), 1e-9)",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      }
    },
