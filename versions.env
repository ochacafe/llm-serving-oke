# concept.md §2 のバージョン固定表。スクリプトはこのファイルを読み込む。
# shellcheck disable=SC2034

# Terraform / OCI
TF_VERSION_ORM=1.5.x                  # OCI Resource Manager の Terraform バージョン
OKE_MODULE_VERSION=5.5.1              # terraform/main.tf と一致させる
KUBERNETES_VERSION=v1.35.2

# Platform
GATEWAY_API_VERSION=v1.6.0
GIE_VERSION=v1.5.0
CERT_MANAGER_VERSION=v1.20.2
AGENTGATEWAY_VERSION=v1.4.1
KSERVE_VERSION=v0.20.0                # 不具合時は v0.20.0-rc0 にフォールバック
KPS_VERSION=92.3.0                    # kube-prometheus-stack（2026-10-12 時点の最新安定版）

# Workload
SIM_IMAGE=ghcr.io/llm-d/llm-d-inference-sim:v0.11.2
LOADGEN_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim   # loadgen をクラスタ内で動かすベースイメージ
